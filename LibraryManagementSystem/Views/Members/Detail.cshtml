@model LibraryManagement.Models.Member
@{
    Layout = "_Layout";
    var tx = ViewBag.Transactions as IEnumerable<LibraryManagement.Models.TransactionRecord>;
}
<h2>Member Details</h2>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Borrowed Books</dt>
    <dd class="col-sm-9">@Model.BorrowedBookIds.Count</dd>
</dl>

<h4>Transactions</h4>
@if (tx != null && tx.Any())
{
    <table class="table table-sm">
        <thead><tr><th>Book Id</th><th>Borrowed</th><th>Returned</th></tr></thead>
        <tbody>
            @foreach (var t in tx)
            {
                <tr>
                    <td>@t.BookId</td>
                    <td>@t.BorrowedAt.ToLocalTime()</td>
                    <td>@(t.ReturnedAt?.ToLocalTime().ToString() ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>No transactions</em></p>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>