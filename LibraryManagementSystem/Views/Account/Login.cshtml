@model LibraryManagement.Models.Member
@{
    Layout = "_Layout";
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = "Login";
}
<h2>Login</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnUrl="@returnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Log in</button>
            <p class="mt-3">Don't have an account? <a asp-controller="Members" asp-action="Create">Register here</a>.</p>
        </form>
    </div>
</div>