@model IEnumerable<LibraryManagement.Models.Book>
@{
    ViewData["Title"] = "Books";
}
<h2>Books</h2>
<p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Add Book</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Books")" class="btn btn-outline-secondary">Login to Add Book</a>
    }
    <a asp-action="Available" class="btn btn-info">Available</a>
    <a asp-action="Borrowed" class="btn btn-warning">Borrowed</a>
</p>

<table class="table table-striped">
    <thead>
        <tr><th>Title</th><th>Author</th><th>ISBN</th><th>Status</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td>@b.Isbn</td>
                <td>
                    <span class="badge bg-@(b.IsBorrowed ? "warning" : "success")">@(b.IsBorrowed ? "Borrowed" : "Available")</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@b.Id">Details</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span> | <a asp-action="Edit" asp-route-id="@b.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@b.Id">Delete</a></span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>